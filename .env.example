# ─────────────────────────────────────────────────────────────
# MCP Deep Research Agent — configuration
# Copy to `.env` and adjust as needed. NO paid API keys required.
# ─────────────────────────────────────────────────────────────

# --- Ollama (local LLM runtime) ---
# Base URL of your running Ollama server.
OLLAMA_HOST=http://localhost:11434
# Chat / reasoning model. Swap to phi3:mini on low-RAM machines.
OLLAMA_CHAT_MODEL=llama3.1:8b
# Local embedding model used for semantic memory.
OLLAMA_EMBED_MODEL=nomic-embed-text
# Sampling temperature for synthesis (low = more grounded).
LLM_TEMPERATURE=0.2

# --- Storage paths ---
# SQLite database file (structured memory).
RESEARCH_DB_PATH=data/research.db
# ChromaDB persistent directory (vector memory).
CHROMA_DIR=data/chroma
# Tool-invocation log file.
LOG_FILE=data/agent.log

# --- Research behaviour ---
# Max web results fetched per sub-question.
MAX_RESULTS_PER_QUERY=5
# How many top sources to actually scrape per sub-question.
SOURCES_TO_SCRAPE=3
# Cosine-similarity threshold for a memory hit to count as "relevant".
MEMORY_RELEVANCE_THRESHOLD=0.75
# If >= this many strong memory hits are found, skip web search for that sub-question.
RECALL_SHORTCIRCUIT_HITS=2

# --- Tool timeouts (seconds) ---
SEARCH_TIMEOUT=10
SCRAPE_TIMEOUT=30

# --- Scraping etiquette ---
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36
RESPECT_ROBOTS_TXT=true
